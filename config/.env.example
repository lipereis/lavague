# LA VAGUE Bot — Environment Variables Template
# Copy this to config/.env and fill in your values
# NEVER commit the actual .env file to git!

# ==========================================
# DISCORD (Required)
# ==========================================
# Get from: https://discord.com/developers/applications → Your App → Bot → Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Allow all users to interact (set to "false" for allowlist-only)
DISCORD_ALLOW_ALL_USERS=true

# Optional: Comma-separated user IDs allowed to use bot (if ALLOW_ALL_USERS=false)
# DISCORD_ALLOWED_USERS=123456789012345678,987654321098765432

# Optional: Comma-separated channel IDs where bot responds freely (no mention needed)
# DISCORD_FREE_RESPONSE_CHANNELS=123456789012345678,987654321098765432

# ==========================================
# SUBSTACK (Optional - for auto-publishing)
# ==========================================
# Get API key from: https://YOURPUB.substack.com/settings/api
# Enable "Paid subscriptions" in Settings → Payments first
SUBSTACK_API_KEY=sk_your_substack_api_key_here

# Your publication subdomain (from https://YOURSUB.stack.com)
SUBSTACK_PUBLICATION_ID=lavaguemag

# ==========================================
# INSTAGRAM (Optional - requires Meta App Review)
# ==========================================
# Get from: https://developers.facebook.com/apps/ → Your App
# Requires: Instagram Business/Creator account + Facebook Page + App Review approval
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# ==========================================
# SUPABASE (Optional - for MCP server)
# ==========================================
SUPABASE_APIKEY=
SUPABASE_AUTH=

# ==========================================
# GATEWAY SETTINGS
# ==========================================
# Allow all users on all platforms (for testing)
GATEWAY_ALLOW_ALL_USERS=true

# Platform policies (open/pair/allowlist)
# DISCORD_DM_POLICY=open
# DISCORD_GROUP_POLICY=open

# ==========================================
# MODEL SETTINGS (Optional overrides)
# ==========================================
# HERMES_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# HERMES_PROVIDER=nvidia
# HERMES_BASE_URL=https://integrate.api.nvidia.com/v1

# ==========================================
# OBSIDIAN (Optional)
# ==========================================
# Path to your Obsidian vault for auto-save
# OBSIDIAN_VAULT_PATH=C:/Users/Usuario/Documents/Obsidian Vault/LA_VAGUE

# ==========================================
# DEVELOPMENT / DEBUG
# ==========================================
# HERMES_VERBOSE=true
# HERMES_LOG_LEVEL=debug